PORT=3000
# Set to "production" when deploying. In production missing secrets are a hard error
# (never auto-generated) and the .env file is never written.
NODE_ENV=

# Postgres connection string. Required (locally too — e.g. a free Neon dev branch or a local
# Postgres). Example: postgres://user:pass@host/dbname?sslmode=require
DATABASE_URL=

# App-level Steam Web API key (reads any signed-in user's public library)
STEAM_API_KEY=
# RAWG key (game search / metadata)
RAWG_API_KEY=

# Xbox Live (Microsoft OAuth). Register one "Live SDK" / Azure AD app for the whole deployment
# with the redirect URI ${APP_URL}/api/profile/xbox/callback and the "XboxLive.signin
# offline_access" scope, then put its credentials here. Leave blank to hide the Xbox connect option.
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

# Auth
APP_URL=http://localhost:5173
GOOGLE_CLIENT_ID=
# In production, set JWT_SECRET and ENCRYPTION_KEY as real environment variables (host secrets).
# Do NOT rely on the dev auto-generated .env: on an ephemeral filesystem it is lost on redeploy,
# which logs out every user and makes stored PSN tokens permanently undecryptable.
# 48+ random bytes, base64 (e.g. node -e "console.log(require('crypto').randomBytes(48).toString('base64'))")
JWT_SECRET=
# exactly 32 random bytes, base64 (e.g. node -e "console.log(require('crypto').randomBytes(32).toString('base64'))")
ENCRYPTION_KEY=
